{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "noEmit": true
  },
  "include": ["web/**/*.ts", "engine/**/*.ts", "models/**/*.ts", "scenarios/**/*.ts", "views/**/*.ts"]
}
